# Sure Plug request notifications
# The /api/request handler probes these channels in order (webhook -> Telegram -> Resend).
# If none are configured, submissions still succeed (200) and are saved to .data/requests.jsonl.

# ---- 1. Generic webhook (recommended, zero-account option: https://ntfy.sh) ----
# ntfy needs no account: pick a private topic name and subscribe in the ntfy phone app.
#   REQUEST_WEBHOOK_URL=https://ntfy.sh/sureplug-your-private-topic
# Works with any receiver (Make/Zapier/WhatsApp gateway/custom endpoint) that accepts POST JSON.
REQUEST_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>" (ntfy/Make ignore it)
REQUEST_WEBHOOK_SECRET=

# ---- 2. Telegram (needs a bot token from @BotFather and your numeric chat id) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 3. Resend email (instant email alert) ----
# Sign up at resend.com -> Domains -> get RESEND_API_KEY (or use dev key).
RESEND_API_KEY=
REQUEST_NOTIFY_EMAIL=
# Optional "From" address (defaults to onboarding@resend.dev in dev)
# REQUEST_NOTIFY_FROM=Sure Plug <alerts@yourdomain.com>